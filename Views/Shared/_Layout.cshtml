<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · COMSATS Student Portal</title>
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="~/js/tailwind-config.js"></script>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="bg-background font-sans text-on-surface antialiased">
    @await Html.PartialAsync("_PortalNav")

    <main class="w-full pt-16 min-h-[calc(100vh-4rem)]">
        @RenderBody()
    </main>

    <footer class="border-t border-surface-container-high bg-surface">
        <div class="max-w-[1440px] mx-auto px-6 py-4 flex flex-col md:flex-row items-center justify-between gap-2 text-xs text-on-surface-variant">
            <span>&copy; @DateTime.Now.Year COMSATS University Islamabad. All institutional records verified.</span>
            <div class="flex items-center gap-4">
                <a href="#" class="hover:text-on-surface">Academic Regulations</a>
                <a href="#" class="hover:text-on-surface">IT Helpdesk</a>
                <a href="#" class="hover:text-on-surface">Privacy Policy</a>
            </div>
        </div>
    </footer>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
