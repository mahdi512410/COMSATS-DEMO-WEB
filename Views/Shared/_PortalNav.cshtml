@inject Microsoft.AspNetCore.Identity.UserManager<ApplicationUser> UserManager
@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    ApplicationUser? navUser = User.Identity?.IsAuthenticated == true
        ? await UserManager.GetUserAsync(User)
        : null;
    var isTeacher = User.IsInRole("Teacher");

    string LinkClasses(string controllerName) => currentController.Equals(controllerName, StringComparison.OrdinalIgnoreCase)
        ? "text-on-primary border-b-2 border-gold py-5"
        : "text-white/70 hover:text-on-primary transition-colors py-5 border-b-2 border-transparent";
}
<header class="fixed top-0 w-full z-40 bg-primary shadow-[0_1px_8px_rgba(0,0,0,0.15)]">
    <div class="h-16 w-full px-4 md:px-6 flex items-center justify-between">
        <div class="flex items-center gap-8">
            <a href="@(isTeacher ? "/Faculty/Dashboard" : "/Dashboard")" class="flex items-center gap-2.5">
                <span class="flex h-8 w-8 items-center justify-center rounded-md bg-primary-deep text-gold">
                    <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M12 3 2 8l10 5 10-5-10-5Z" />
                        <path d="M6 10.5V16c0 1.5 2.7 3 6 3s6-1.5 6-3v-5.5" />
                    </svg>
                </span>
                <span class="flex flex-col leading-none">
                    <span class="text-sm font-semibold text-on-primary tracking-tight">COMSATS</span>
                    <span class="text-[10px] font-medium text-gold tracking-widest uppercase">@(isTeacher ? "Faculty Portal" : "Student Portal")</span>
                </span>
            </a>
            <nav class="hidden lg:flex items-center gap-6 text-sm font-medium">
                @if (isTeacher) { <a href="/Faculty/Dashboard" class="text-white/70 hover:text-on-primary py-5">Dashboard</a><a href="/Faculty/Classes" class="text-white/70 hover:text-on-primary py-5">Classes</a><a href="/Faculty/Attendance" class="text-white/70 hover:text-on-primary py-5">Attendance</a><a href="/Faculty/Gradebook" class="text-white/70 hover:text-on-primary py-5">Gradebook</a><a href="/Faculty/Timetable" class="text-white/70 hover:text-on-primary py-5">Timetable</a><a href="/Faculty/Profile" class="text-white/70 hover:text-on-primary py-5">Profile</a> }
                else { <a asp-controller="Dashboard" asp-action="Index" class="@LinkClasses("Dashboard")">Dashboard</a><a asp-controller="Courses" asp-action="Index" class="@LinkClasses("Courses")">Courses &amp; Attendance</a><a asp-controller="Profile" asp-action="Index" class="@LinkClasses("Profile")">Student Profile</a> }
            </nav>
        </div>
        <div class="flex items-center gap-4">
            <div class="hidden sm:flex items-center gap-2 rounded-md bg-primary-deep px-3 py-1.5 text-xs font-medium text-white/90">
                <span class="material-symbols-outlined text-[16px] text-gold">calendar_today</span>
                Fall 2024
            </div>
            <button type="button" class="relative rounded-md p-2 text-white/70 hover:bg-primary-deep hover:text-on-primary transition-colors" aria-label="Notifications">
                <span class="material-symbols-outlined text-[20px]">notifications</span>
                <span class="absolute top-1.5 right-1.5 h-1.5 w-1.5 rounded-full bg-gold"></span>
            </button>
            @if (navUser is not null)
            {
                <div class="flex items-center gap-2.5 pl-2 border-l border-white/15">
                    <div class="hidden md:flex flex-col text-right leading-tight">
                        <span class="text-sm font-medium text-on-primary">@navUser.FullName</span>
                        <span class="text-[11px] text-gold tabular-nums">@navUser.RegistrationId</span>
                    </div>
                    <span class="avatar-initials h-8 w-8 rounded-full text-xs ring-1 ring-white/20" aria-hidden="true">@navUser.Initials</span>
                    <form asp-controller="Account" asp-action="Logout" method="post" class="ml-1">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="rounded-md p-2 text-white/70 hover:bg-primary-deep hover:text-on-primary transition-colors" aria-label="Sign out" title="Sign out">
                            <span class="material-symbols-outlined text-[20px]">logout</span>
                        </button>
                    </form>
                </div>
            }
        </div>
    </div>
</header>
