@{ ViewData["Title"] = "Faculty Dashboard"; }
<section class="p-6"><h1 class="text-2xl font-bold">Faculty Dashboard</h1><p class="text-on-surface-variant">Your teaching overview is loaded from the portal API.</p><div id="faculty-content" class="mt-6">Loading…</div></section>
<script>fetch('/api/faculty/dashboard').then(r=>r.json()).then(d=>document.querySelector('#faculty-content').innerHTML=`<p class="mb-3">Welcome, ${d.teacher}</p><p>${d.unmarkedSessions} unfinalized session(s)</p><ul>${d.todayClasses.map(x=>`<li>${x.start}–${x.end} · ${x.code} ${x.title} · ${x.room}</li>`).join('')||'<li>No classes today.</li>'}</ul>`);</script>
