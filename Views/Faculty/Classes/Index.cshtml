@{ ViewData["Title"] = "My Classes"; }
<section class="p-6"><h1 class="text-2xl font-bold">My Classes</h1><div id="faculty-content" class="mt-6">Loading…</div></section>
<script>fetch('/api/faculty/offerings').then(r=>r.json()).then(d=>document.querySelector('#faculty-content').innerHTML=`<ul class="space-y-2">${d.map(x=>`<li><a class="text-primary underline" href="/Faculty/Attendance?offeringId=${x.id}">${x.code}: ${x.title} (Section ${x.section})</a> — ${x.enrolled} student(s)</li>`).join('')}</ul>`);</script>
