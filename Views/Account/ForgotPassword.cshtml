@{
    ViewData["Title"] = "Reset Access";
    Layout = "_LoginLayout";
}

<div class="w-full max-w-md bg-surface rounded-xl shadow-raised p-8">
    <div class="w-11 h-11 rounded-lg bg-gold-tint flex items-center justify-center mb-4">
        <span class="material-symbols-outlined text-primary">support_agent</span>
    </div>
    <h1 class="text-xl font-bold text-on-surface mb-2">Reset your CU-PIN</h1>
    <p class="text-sm text-on-surface-variant leading-relaxed mb-5">
        Password resets for the Student Information System are handled by the IT Helpdesk to protect
        academic records. Bring your Student Card or CNIC to the helpdesk counter, or email the
        request from your registered personal address.
    </p>
    <div class="space-y-2 text-sm text-on-surface mb-6">
        <p class="flex items-center gap-2"><span class="material-symbols-outlined text-base text-primary">mail</span> support@comsats.edu.pk</p>
        <p class="flex items-center gap-2"><span class="material-symbols-outlined text-base text-primary">call</span> UAN: +92-51-111-001-007</p>
        <p class="flex items-center gap-2"><span class="material-symbols-outlined text-base text-primary">location_on</span> Room 104, Admin Block</p>
    </div>
    <a asp-controller="Account" asp-action="Login" class="btn-secondary w-full h-10 rounded-md text-sm font-medium flex items-center justify-center">Back to Sign In</a>
</div>
