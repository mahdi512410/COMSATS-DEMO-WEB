@model CoursesViewModel
@{
    ViewData["Title"] = "Courses & Attendance";
}

<div class="max-w-[1440px] w-full mx-auto px-4 md:px-6 py-6 flex flex-col gap-5">
    <div>
        <h1 class="text-2xl md:text-3xl font-bold text-on-surface tracking-tight">Courses &amp; Attendance</h1>
        <p class="text-sm text-on-surface-variant mt-1">Registered load for @Model.CurrentTerm.</p>
    </div>

    <section class="bg-surface rounded-xl shadow-card overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-sm min-w-[820px]">
                <thead>
                    <tr class="text-left text-xs uppercase tracking-wide text-on-surface-variant border-b-2 border-surface-container-high bg-surface-container-low">
                        <th class="py-3 px-4 font-medium">Course</th>
                        <th class="py-3 px-4 font-medium">Instructor</th>
                        <th class="py-3 px-4 font-medium">Location</th>
                        <th class="py-3 px-4 font-medium text-right">Credit Hrs</th>
                        <th class="py-3 px-4 font-medium text-right">Midterm</th>
                        <th class="py-3 px-4 font-medium text-center">Grade</th>
                        <th class="py-3 px-4 font-medium">Attendance</th>
                        <th class="py-3 px-4 font-medium text-center">Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in Model.Courses)
                    {
                        var badgeClasses = c.AttendanceRiskLabel switch
                        {
                            "Safe" => "bg-success-surface text-success border-success-border",
                            "AtRisk" => "bg-warning-surface text-warning border-warning-border",
                            _ => "bg-critical-surface text-critical border-critical-border"
                        };
                        var barColor = c.AttendanceRiskLabel switch
                        {
                            "Safe" => "bg-success",
                            "AtRisk" => "bg-gold",
                            _ => "bg-critical"
                        };
                        <tr class="border-b border-surface-container-low last:border-b-0 hover:bg-surface-container-low/60 transition-colors">
                            <td class="py-3 px-4">
                                <div class="font-semibold text-on-surface">@c.Code</div>
                                <div class="text-xs text-on-surface-variant">@c.Title</div>
                            </td>
                            <td class="py-3 px-4 text-on-surface-variant">@c.InstructorName</td>
                            <td class="py-3 px-4 text-on-surface-variant">@c.Location</td>
                            <td class="py-3 px-4 text-right tabular-nums">@c.CreditHours</td>
                            <td class="py-3 px-4 text-right tabular-nums">@(c.MidtermMarks is not null ? $"{c.MidtermMarks}/{c.MidtermTotal}" : "—")</td>
                            <td class="py-3 px-4 text-center font-semibold">@(c.Grade ?? "—")</td>
                            <td class="py-3 px-4">
                                @if (c.SessionsTotal > 0)
                                {
                                    <div class="flex items-center gap-2">
                                        <div class="h-1.5 w-24 rounded-full bg-surface-container-high overflow-hidden">
                                            <div class="h-full @barColor rounded-full" style="width: @(c.AttendancePercentage.ToString("0.#"))%"></div>
                                        </div>
                                        <span class="text-xs tabular-nums text-on-surface-variant">@c.AttendancePercentage.ToString("0.#")% (@c.SessionsAttended/@c.SessionsTotal)</span>
                                    </div>
                                }
                                else
                                {
                                    <span class="text-xs text-on-surface-muted">Not tracked</span>
                                }
                            </td>
                            <td class="py-3 px-4 text-center">
                                <span class="px-2 py-0.5 rounded border text-xs font-medium @badgeClasses">@c.Status</span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>
</div>
